# Copy to .env and fill in locally. .env is gitignored; this file is not.
# Frame Forge reads secrets from the environment only and never writes them to a report.

# Optional. Enables the tier-1 AI planner. Without it, ai: off is fully supported.
FRAMEFORGE_AI_API_KEY=

# Optional. Overrides for the OpenAI-compatible provider.
# FRAMEFORGE_AI_BASE_URL=https://api.example.com/v1
# FRAMEFORGE_AI_MODEL=some-model
